datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Guild {
  id               String         @id
  cronSchedule     String         @default("0 4 * * *")
  language         String         @default("en")
  serpApiKey        String?
  sources          String         @default("serpapi")
  antcatLastRefId  Int            @default(144725)
  enabled          Boolean        @default(true)
  watchChannels    WatchChannel[]
  articles         Article[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model WatchChannel {
  id        Int       @id @default(autoincrement())
  guildId   String
  channelId String
  name      String?
  guild     Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  keywords  Keyword[]
  createdAt DateTime  @default(now())

  @@unique([guildId, channelId])
}

model Keyword {
  id             Int          @id @default(autoincrement())
  watchChannelId Int
  value          String
  createdAt      DateTime     @default(now())
  watchChannel   WatchChannel @relation(fields: [watchChannelId], references: [id], onDelete: Cascade)

  @@unique([watchChannelId, value])
}

model Article {
  id         Int      @id @default(autoincrement())
  guildId    String
  externalId String
  source     String
  title      String
  authors    String?
  year       Int?
  link       String
  doi        String?
  notifiedAt DateTime @default(now())
  guild      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, externalId])
  @@index([guildId, source])
}
